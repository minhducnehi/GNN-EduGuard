@model GNN_EduGuard.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Học vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Bảng điều khiển Giám sát Nguy cơ Học tập</h3>
        <p class="text-muted mb-0">Dự đoán và phát hiện sớm sinh viên có nguy cơ trượt môn / bỏ học bằng Heterogeneous GNN</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-person-lines-fill me-1"></i> Xem toàn bộ sinh viên
        </a>
        <a asp-controller="Students" asp-action="Index" asp-route-riskFilter="HighRisk" class="btn btn-danger">
            <i class="bi bi-bell-fill me-1"></i> Xử lý nguy cơ gấp (@Model.HighRiskCount)
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Tổng sinh viên theo dõi</span>
                    <h2 class="fw-bold mt-2 mb-0">@Model.TotalStudents</h2>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                <i class="bi bi-check-circle text-success me-1"></i> Cập nhật theo thời gian thực
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 bg-white border-danger-subtle">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-danger small text-uppercase fw-semibold">Nguy cơ cao (Báo động)</span>
                    <h2 class="fw-bold mt-2 mb-0 text-danger">@Model.HighRiskCount</h2>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                    <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-danger fw-medium">
                <i class="bi bi-arrow-up-right me-1"></i> Chiếm @Model.HighRiskPercentage% tổng số sinh viên
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 bg-white border-warning-subtle">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-warning-emphasis small text-uppercase fw-semibold">Nguy cơ vừa (Cần theo dõi)</span>
                    <h2 class="fw-bold mt-2 mb-0 text-warning-emphasis">@Model.ModerateRiskCount</h2>
                </div>
                <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-circle">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                Chiếm @Model.ModerateRiskPercentage% tổng số sinh viên
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 bg-white border-success-subtle">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-success small text-uppercase fw-semibold">Nhóm an toàn</span>
                    <h2 class="fw-bold mt-2 mb-0 text-success">@Model.SafeCount</h2>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-success">
                Chiếm @Model.SafePercentage% tổng số sinh viên
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card p-3 h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Phân bố mức độ nguy cơ</h5>
            <div style="height: 260px;" class="d-flex justify-content-center align-items-center">
                <canvas id="riskDistributionChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-3 h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Độ chính xác mô hình GNN so với Baseline</h5>
            <div style="height: 260px;">
                <canvas id="modelComparisonChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- High Risk Alert Table -->
<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-danger">
            <i class="bi bi-shield-exclamation me-2"></i>Danh sách sinh viên nguy cơ cao cần can thiệp gấp
        </h5>
        <span class="badge bg-danger">@Model.TopHighRiskStudents.Count sinh viên cần hỗ trợ</span>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã SV</th>
                    <th>Họ và tên</th>
                    <th>Lớp</th>
                    <th>Xác suất nguy cơ</th>
                    <th>Mức độ</th>
                    <th>Nguyên nhân chính (GNN Explainability)</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sv in Model.TopHighRiskStudents)
                {
                    <tr>
                        <td class="fw-semibold">@sv.StudentCode</td>
                        <td>
                            <div class="fw-bold">@sv.FullName</div>
                            <small class="text-muted">@sv.Email</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@sv.ClassName</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-danger" style="width: @((int)(sv.RiskProbability * 100))%"></div>
                                </div>
                                <span class="fw-bold text-danger">@((int)(sv.RiskProbability * 100))%</span>
                            </div>
                        </td>
                        <td><span class="badge badge-high-risk px-3 py-2 rounded-pill">Nguy cơ cao</span></td>
                        <td><small class="text-muted"><i class="bi bi-info-circle me-1 text-danger"></i>@sv.TopRiskFactor</small></td>
                        <td>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-search me-1"></i> Xem giải thích
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // 1. Risk Distribution Doughnut Chart
    const ctxRisk = document.getElementById('riskDistributionChart').getContext('2d');
    new Chart(ctxRisk, {
        type: 'doughnut',
        data: {
            labels: ['Nguy cơ cao', 'Nguy cơ vừa', 'An toàn'],
            datasets: [{
                data: [@Model.HighRiskCount, @Model.ModerateRiskCount, @Model.SafeCount],
                backgroundColor: ['#ef4444', '#f59e0b', '#22c55e'],
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // 2. Model Benchmark Comparison
    const ctxModel = document.getElementById('modelComparisonChart').getContext('2d');
    new Chart(ctxModel, {
        type: 'bar',
        data: {
            labels: ['F1-Score', 'AUC-ROC', 'Recall (Nhóm nguy cơ)'],
            datasets: [
                {
                    label: 'Baseline (Random Forest / Tabular)',
                    data: [0.68, 0.74, 0.65],
                    backgroundColor: '#cbd5e1'
                },
                {
                    label: 'GNN HeteroGAT / HGT (Đồ thị học tập)',
                    data: [0.82, 0.88, 0.85],
                    backgroundColor: '#2563eb'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { min: 0.5, max: 1.0 }
            },
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
