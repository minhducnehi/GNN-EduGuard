@model GNN_EduGuard.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Học vụ";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Bảng điều khiển Giám sát & Hỗ trợ Học tập</h3>
        <p class="text-muted mb-0">Dự báo sớm theo tuần bằng Causal Temporal-HGT (8 đặc trưng công bằng gồm điểm danh &amp; số ngày hoạt động VLE, không dùng biến nhân khẩu học)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Students" asp-action="ExportCsv" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Báo cáo CSV
        </a>
        <a asp-controller="Students" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-person-lines-fill me-1"></i> Xem toàn bộ sinh viên
        </a>
        <a asp-controller="Students" asp-action="Index" asp-route-riskFilter="HighRisk" class="btn btn-outline-danger">
            <i class="bi bi-bell-fill me-1"></i> Cần hỗ trợ ưu tiên (@Model.HighRiskCount)
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card eg-card-interactive p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Tổng sinh viên theo dõi</span>
                    <h2 class="fw-bold mt-2 mb-0">@Model.TotalStudents</h2>
                </div>
                <div class="eg-badge-normal p-3 rounded-circle border-0">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                <i class="bi bi-check-circle text-primary me-1"></i> Đồng bộ trực tiếp với GNN Engine
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card eg-card-interactive p-3 h-100" style="border-color: var(--eg-alert-border);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-danger small text-uppercase fw-semibold">Nguy cơ cao (&gt;= 70%)</span>
                    <h2 class="fw-bold mt-2 mb-0 text-danger">@Model.HighRiskCount</h2>
                </div>
                <div class="eg-badge-alert p-3 rounded-circle border-0">
                    <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-danger fw-medium">
                <i class="bi bi-arrow-up-right me-1"></i> Chiếm @Model.HighRiskPercentage% tổng số sinh viên
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card eg-card-interactive p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Nguy cơ vừa (40% - 69%)</span>
                    <h2 class="fw-bold mt-2 mb-0">@Model.ModerateRiskCount</h2>
                </div>
                <div class="eg-badge-moderate p-3 rounded-circle border-0">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                Chiếm @Model.ModerateRiskPercentage% tổng số sinh viên
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card eg-card-interactive p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-primary small text-uppercase fw-semibold">Nhóm an toàn (&lt; 40%)</span>
                    <h2 class="fw-bold mt-2 mb-0 text-primary">@Model.SafeCount</h2>
                </div>
                <div class="eg-badge-normal p-3 rounded-circle border-0">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-primary">
                Chiếm @Model.SafePercentage% tổng số sinh viên
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card p-3 h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Phân bố mức độ nguy cơ</h5>
            <div style="height: 260px;" class="d-flex justify-content-center align-items-center">
                <canvas id="riskDistributionChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Thực nghiệm Mô hình GNN so với Baseline (Tập Test)</h5>
                <span class="badge bg-light text-dark border">Dữ liệu thực nghiệm động</span>
            </div>
            <div style="height: 260px;">
                <canvas id="modelComparisonChart"></canvas>
            </div>
        </div>
    </div>
</div>

@if (Model.FeatureImportances.Any())
{
    <!-- Global Feature Importance (GridSearchCV-tuned Random Forest, permutation importance) -->
    <div class="card p-3 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h5 class="fw-bold mb-0"><i class="bi bi-sort-down text-primary me-2"></i>Mức độ quan trọng của đặc trưng (Global Feature Importance)</h5>
            <span class="badge bg-light text-dark border">Random Forest + GridSearchCV 5-fold</span>
        </div>
        <p class="text-muted small mb-2">@Model.FeatureImportanceMethod</p>
        <div style="height: 280px;">
            <canvas id="featureImportanceChart"></canvas>
        </div>
    </div>
}

<!-- High Risk Alert Table -->
<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-danger">
            <i class="bi bi-shield-exclamation me-2"></i>Danh sách sinh viên cần ưu tiên hỗ trợ học tập
        </h5>
        <span class="badge eg-badge-alert px-3 py-2 rounded-pill">@Model.TopHighRiskStudents.Count sinh viên cần hỗ trợ</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã SV</th>
                    <th>Họ và tên</th>
                    <th>Lớp</th>
                    <th>Xác suất nguy cơ</th>
                    <th>Mức độ</th>
                    <th>Nguyên nhân chính (GNN Explainability)</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sv in Model.TopHighRiskStudents)
                {
                    <tr>
                        <td class="fw-semibold">@sv.StudentCode</td>
                        <td>
                            <div class="fw-bold">@sv.FullName</div>
                            <small class="text-muted">@sv.Email</small>
                        </td>
                        <td><span class="badge eg-badge-moderate">@sv.ClassName</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="eg-risk-progress flex-grow-1">
                                    <div class="eg-risk-progress-bar" style="width: @((int)(sv.RiskProbability * 100))%"></div>
                                </div>
                                <span class="fw-bold text-danger">@((int)(sv.RiskProbability * 100))%</span>
                            </div>
                        </td>
                        <td><span class="badge badge-high-risk px-3 py-2 rounded-pill">Nguy cơ cao</span></td>
                        <td><small class="text-muted"><i class="bi bi-info-circle me-1 text-danger"></i>@sv.TopRiskFactor</small></td>
                        <td>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-search me-1"></i> Xem giải thích &amp; Tư vấn
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // 1. Risk Distribution Doughnut Chart
    const ctxRisk = document.getElementById('riskDistributionChart').getContext('2d');
    new Chart(ctxRisk, {
        type: 'doughnut',
        data: {
            labels: ['Nguy cơ cao (>= 70%)', 'Nguy cơ vừa (40-69%)', 'An toàn (< 40%)'],
            datasets: [{
                data: [@Model.HighRiskCount, @Model.ModerateRiskCount, @Model.SafeCount],
                backgroundColor: ['#F42902', '#94A3B8', '#0099FF'],
                borderColor: '#FFFFFF',
                borderWidth: 2,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // 2. Dynamic Model Benchmark Comparison (Loaded from benchmark_summary.json / FastAPI)
    const ctxModel = document.getElementById('modelComparisonChart').getContext('2d');
    new Chart(ctxModel, {
        type: 'bar',
        data: {
            labels: ['F1-Score (Macro)', 'AUC-ROC', 'Recall (Phát hiện nhóm nguy cơ)'],
            datasets: [
                {
                    label: '@Html.Raw(Model.BaselineMetrics.ModelName)',
                    data: [@Model.BaselineMetrics.F1Macro.ToString(inv), @Model.BaselineMetrics.AucRoc.ToString(inv), @Model.BaselineMetrics.RecallRisk.ToString(inv)],
                    backgroundColor: '#CBD5E1',
                    borderRadius: 6
                },
                {
                    label: '@Html.Raw(Model.GnnMetrics.ModelName)',
                    data: [@Model.GnnMetrics.F1Macro.ToString(inv), @Model.GnnMetrics.AucRoc.ToString(inv), @Model.GnnMetrics.RecallRisk.ToString(inv)],
                    backgroundColor: '#0099FF',
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { min: 0.5, max: 1.0 }
            },
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // 3. Global Feature Importance (horizontal bar)
    const fiCanvas = document.getElementById('featureImportanceChart');
    if (fiCanvas) {
        new Chart(fiCanvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FeatureImportances.Select(f => f.FeatureName))),
                datasets: [
                    {
                        label: 'Permutation importance (giảm AUC khi xáo trộn)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FeatureImportances.Select(f => Math.Round(f.PermutationImportance, 4)))),
                        backgroundColor: '#0099FF',
                        borderRadius: 6
                    },
                    {
                        label: 'RF impurity importance',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FeatureImportances.Select(f => Math.Round(f.ImpurityImportance, 4)))),
                        backgroundColor: '#CBD5E1',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    }
</script>
}
