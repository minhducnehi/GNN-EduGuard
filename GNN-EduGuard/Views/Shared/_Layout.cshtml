<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GNN EduGuard</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <!-- EduGuard Design System -->
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var currentRole = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("Student") ? "Student" : "Advisor");
        var currentRoleLabel = currentRole switch
        {
            "Admin" => "Quản trị viên (Admin)",
            "Student" => "Sinh viên",
            _ => "Giáo viên"
        };
        var currentUserName = User.Identity?.Name ?? string.Empty;
        var studentIdClaim = User.FindFirst("StudentId")?.Value ?? "1";
        var assignedClassesClaim = User.FindFirst("AssignedClasses")?.Value ?? string.Empty;
    }
    <nav class="navbar navbar-expand-lg navbar-light eg-navbar sticky-top px-3">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                @if (isAuthenticated)
                {
                    <!-- Mobile Hamburger Button -->
                    <button class="btn btn-outline-primary btn-sm d-md-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-label="Mở menu điều hướng">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                }
                <a class="navbar-brand d-flex align-items-center mb-0" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-diagram-3-fill fs-3 text-primary me-2"></i>
                    <span>GNN <span style="color: var(--eg-text-main);">EduGuard</span></span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge eg-badge-normal px-3 py-2 rounded-pill d-none d-sm-inline-flex align-items-center">
                    <i class="bi bi-cpu me-1"></i> Fair HGT + Causal LSTM (v1.1)
                </span>

                @if (isAuthenticated)
                {
                    @if (currentRole == "Advisor" && !string.IsNullOrWhiteSpace(assignedClassesClaim))
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-2 d-none d-md-inline-flex align-items-center">
                            <i class="bi bi-collection me-1"></i> Lớp: @assignedClassesClaim
                        </span>
                    }
                    <span class="badge bg-light text-dark border px-3 py-2 d-none d-md-inline-flex align-items-center">
                        <i class="bi bi-person-circle text-primary me-1"></i> @currentUserName &bull; @currentRoleLabel
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            @if (isAuthenticated)
            {
                <!-- Responsive Sidebar (Desktop Static + Mobile Offcanvas) -->
                <div class="col-md-3 col-lg-2 p-0 sidebar">
                    <div class="offcanvas-md offcanvas-start h-100" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
                        <div class="offcanvas-header border-bottom d-md-none">
                            <h5 class="offcanvas-title fw-bold text-primary" id="sidebarMenuLabel">
                                <i class="bi bi-diagram-3-fill me-1"></i> GNN EduGuard
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Đóng"></button>
                        </div>
                        <div class="offcanvas-body d-flex flex-column p-3">
                            <div class="nav flex-column nav-pills w-100">
                                <small class="text-uppercase text-muted fw-bold px-3 mb-2" style="font-size: 0.75rem;">Menu Quản lý</small>
                                @if (currentRole != "Student")
                                {
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                                       asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2"></i> Tổng quan Dashboard
                                    </a>
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                                       asp-controller="Students" asp-action="Index">
                                        <i class="bi bi-people me-2"></i> Danh sách sinh viên
                                    </a>
                                    <a class="nav-link eg-nav-alert" asp-controller="Students" asp-action="Index" asp-route-riskFilter="HighRisk">
                                        <i class="bi bi-exclamation-triangle me-2 text-danger"></i> Cảnh báo nguy cơ cao
                                    </a>
                                    <a class="nav-link" asp-controller="Students" asp-action="ExportCsv">
                                        <i class="bi bi-file-earmark-spreadsheet me-2 text-primary"></i> Xuất báo cáo CSV
                                    </a>
                                }
                                else
                                {
                                    <a class="nav-link active" asp-controller="Students" asp-action="Details" asp-route-id="@studentIdClaim">
                                        <i class="bi bi-mortarboard me-2"></i> Lộ trình Học tập Cá nhân
                                    </a>
                                }

                                <hr class="my-3" style="border-color: var(--eg-border);" />
                                <small class="text-uppercase text-muted fw-bold px-3 mb-2" style="font-size: 0.75rem;">Mô hình & Dữ liệu</small>
                                <a class="nav-link" href="/openapi/v1.json" target="_blank">
                                    <i class="bi bi-file-earmark-code me-2"></i> OpenAPI JSON
                                </a>
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy">
                                    <i class="bi bi-info-circle me-2"></i> Giới thiệu hệ thống
                                </a>
                            </div>

                            <div class="mt-auto pt-4 px-2 small text-muted border-top">
                                <div class="fw-semibold" style="color: var(--eg-text-main);"><i class="bi bi-shield-lock text-primary me-1"></i>@currentUserName</div>
                                <div class="mt-1">Phân quyền: <span class="badge eg-badge-normal">@currentRoleLabel</span></div>
                                @if (currentRole == "Advisor" && !string.IsNullOrWhiteSpace(assignedClassesClaim))
                                {
                                    <div class="mt-1">Lớp phụ trách: <strong>@assignedClassesClaim</strong></div>
                                }
                                else if (currentRole == "Admin")
                                {
                                    <div class="mt-1">Phạm vi: <strong>Toàn bộ hệ thống</strong></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Main Content -->
            <main class="@(isAuthenticated ? "col-md-9 col-lg-10 p-3 p-md-4" : "col-12 p-3 p-md-4")">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert eg-alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert eg-alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
