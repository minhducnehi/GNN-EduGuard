<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GNN EduGuard</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .navbar-brand {
            font-weight: 700;
            color: #2563eb !important;
            letter-spacing: -0.5px;
        }
        .sidebar {
            background-color: #ffffff;
            border-right: 1px solid #e2e8f0;
            min-height: calc(100vh - 60px);
        }
        .nav-link {
            font-weight: 500;
            color: #64748b;
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 4px;
        }
        .nav-link:hover, .nav-link.active {
            color: #2563eb;
            background-color: #eff6ff;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        .badge-high-risk {
            background-color: #fee2e2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }
        .badge-moderate {
            background-color: #fef3c7;
            color: #d97706;
            border: 1px solid #fde68a;
        }
        .badge-safe {
            background-color: #dcfce7;
            color: #16a34a;
            border: 1px solid #bbf7d0;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top px-3">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="bi bi-diagram-3-fill fs-3 text-primary me-2"></i>
                <span>GNN <span class="text-dark">EduGuard</span></span>
            </a>
            <div class="d-flex align-items-center">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill me-3">
                    <i class="bi bi-cpu me-1"></i> GNN Engine: Active (HGT v1.0)
                </span>
                <span class="text-muted small">Hệ thống Cảnh báo Sớm Học vụ</span>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 p-3 sidebar d-none d-md-block">
                <div class="nav flex-column nav-pills">
                    <small class="text-uppercase text-muted fw-bold px-3 mb-2" style="font-size: 0.75rem;">Menu Quản lý</small>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Tổng quan Dashboard
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")" 
                       asp-controller="Students" asp-action="Index">
                        <i class="bi bi-people me-2"></i> Danh sách sinh viên
                    </a>
                    <a class="nav-link" asp-controller="Students" asp-action="Index" asp-route-riskFilter="HighRisk">
                        <i class="bi bi-exclamation-triangle me-2 text-danger"></i> Cảnh báo nguy cơ cao
                    </a>

                    <hr class="my-3 text-secondary" />
                    <small class="text-uppercase text-muted fw-bold px-3 mb-2" style="font-size: 0.75rem;">Mô hình & Dữ liệu</small>
                    <a class="nav-link" href="/openapi/v1.json" target="_blank">
                        <i class="bi bi-file-earmark-code me-2"></i> OpenAPI JSON
                    </a>
                    <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-info-circle me-2"></i> Giới thiệu hệ thống
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <main class="col-md-9 col-lg-10 p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
