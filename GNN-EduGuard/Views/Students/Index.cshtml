@model List<GNN_EduGuard.Models.Student>
@{
    ViewData["Title"] = "Danh sách Sinh viên";
    var currentFilter = ViewBag.CurrentFilter as GNN_EduGuard.Models.RiskLevel?;
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản lý & Theo dõi Sinh viên</h3>
        <p class="text-muted mb-0">Theo dõi điểm số, lượt click VLE và chỉ số nguy cơ dự đoán từ mô hình GNN</p>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card p-3 mb-4">
    <form method="get" asp-controller="Students" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Tìm theo Mã SV, Họ tên hoặc Lớp..." value="@currentSearch" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="riskFilter" class="form-select">
                <option value="">-- Tất cả mức độ nguy cơ --</option>
                <option value="HighRisk" selected="@(currentFilter == GNN_EduGuard.Models.RiskLevel.HighRisk)">Nguy cơ cao (> 70%)</option>
                <option value="Moderate" selected="@(currentFilter == GNN_EduGuard.Models.RiskLevel.Moderate)">Nguy cơ vừa (40% - 70%)</option>
                <option value="Safe" selected="@(currentFilter == GNN_EduGuard.Models.RiskLevel.Safe)">An toàn (< 40%)</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
            </button>
            <a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã SV</th>
                    <th>Họ và tên</th>
                    <th>Lớp</th>
                    <th>GPA trước</th>
                    <th>Clicks VLE</th>
                    <th>Nộp muộn</th>
                    <th>Xác suất nguy cơ</th>
                    <th>Mức độ</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-emoji-neutral fs-2 d-block mb-2"></i>
                            Không tìm thấy sinh viên nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
                @foreach (var sv in Model)
                {
                    <tr>
                        <td class="fw-bold">@sv.StudentCode</td>
                        <td>
                            <div class="fw-semibold">@sv.FullName</div>
                            <small class="text-muted">@sv.Email</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@sv.ClassName</span></td>
                        <td><span class="fw-semibold">@sv.GpaBefore.ToString("F2")</span></td>
                        <td>
                            <span class="badge @(sv.TotalVleClicks < 150 ? "bg-danger-subtle text-danger" : "bg-light text-dark") border">
                                @sv.TotalVleClicks clicks
                            </span>
                        </td>
                        <td>@((int)(sv.LateSubmissionRate * 100))%</td>
                        <td>
                            <div class="d-flex align-items-center gap-2" style="min-width: 140px;">
                                <div class="progress flex-grow-1" style="height: 6px;">
                                    @{
                                        string barColor = sv.RiskLevel switch {
                                            GNN_EduGuard.Models.RiskLevel.HighRisk => "bg-danger",
                                            GNN_EduGuard.Models.RiskLevel.Moderate => "bg-warning",
                                            _ => "bg-success"
                                        };
                                    }
                                    <div class="progress-bar @barColor" style="width: @((int)(sv.RiskProbability * 100))%"></div>
                                </div>
                                <span class="fw-bold small">@((int)(sv.RiskProbability * 100))%</span>
                            </div>
                        </td>
                        <td>
                            @switch (sv.RiskLevel)
                            {
                                case GNN_EduGuard.Models.RiskLevel.HighRisk:
                                    <span class="badge badge-high-risk px-2 py-1 rounded-pill">Nguy cơ cao</span>
                                    break;
                                case GNN_EduGuard.Models.RiskLevel.Moderate:
                                    <span class="badge badge-moderate px-2 py-1 rounded-pill">Nguy cơ vừa</span>
                                    break;
                                default:
                                    <span class="badge badge-safe px-2 py-1 rounded-pill">An toàn</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@sv.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> Chi tiết & Giải thích
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
